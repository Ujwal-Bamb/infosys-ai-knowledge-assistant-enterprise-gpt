# Application
APP_NAME="Infosys AI Knowledge Assistant"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# CORS (Comma-separated origins for local dev and Vercel deployment)
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# Database (Docker PostgreSQL + pgvector locally / Managed Postgres on Render)
DATABASE_URL=postgresql+psycopg://infosys_user:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/infosys_ai

# Authentication & JWT Security
SECRET_KEY=REPLACE_WITH_A_SECURE_64_CHAR_HEX_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI & LLM Configuration (Google Gemini API)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# Embeddings Configuration
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536

# Document Storage Configuration
STORAGE_PROVIDER=local
STORAGE_BUCKET=infosys-knowledge-docs
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25